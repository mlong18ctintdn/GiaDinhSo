# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ===== AI =====
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Leave empty: the app tries gemini-3.8-flash, then 3.6-flash, 3.5-flash-lite, 3.1-flash-lite,
# then asks Google which flash models your key can use. (gemini-1.5-* and 2.0-* are shut down.)
GEMINI_MODEL=
# Optional fallback if Gemini is down
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== PayOS (my.payos.vn > Payment channel) =====
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ===== App address =====
# Leave EMPTY on Vercel: the app uses your Vercel domain automatically.
# Set it only for a custom domain, e.g. https://giadinhso.vn   (local dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Prices in VND (defaults shown) =====
NEXT_PUBLIC_PLAN_MONTHLY_VND=39000
NEXT_PUBLIC_PLAN_YEARLY_VND=390000
